{
 "about": "Grid text in, import CSV out (spec 0025 AC-17). The site's builder runs every case; the Import Wizard runs each case not marked site_only through its own load step and getImportFile. A case is site_only when its grid text is something the wizard never keeps: text sent as typed, or a number or date written in the site's own format (the wizard reads only plain numbers and ISO dates). Each csv lists only the columns the case names.",
 "cases": [
  {
   "name": "a three row invoice whose rows are apart in the grid, with a numbered name that is not sent",
   "schema_name": "SalesInvoice",
   "doctype": "Books Sales Invoice",
   "number_format": "#,###.##",
   "date_format": "dd-mm-yyyy",
   "site_only": false,
   "columns": ["name", "party", "items.item", "items.quantity", "items.rate"],
   "rows": [
    ["A", "Ann", "Pen", "2", "10.50"],
    ["B", "Bob", "Ink", "1", "4"],
    ["A", "", "Pad", "3", "1.25"],
    ["", "", "", "", ""],
    ["A", "Amy", "Pen", "1", "10.50"]
   ],
   "csv": [
    ["docstatus", "party", "items.item", "items.quantity", "items.rate"],
    ["0", "Amy", "Pen", "2", "10.5"],
    ["", "", "Pad", "3", "1.25"],
    ["", "", "Pen", "1", "10.5"],
    ["0", "Bob", "Ink", "1", "4"]
   ]
  },
  {
   "name": "plain amounts on a #.###,## site are written with its comma, trailing zeros trimmed",
