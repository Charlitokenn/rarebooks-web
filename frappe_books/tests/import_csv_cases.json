   "date_format": "dd-mm-yyyy",
   "site_only": false,
   "columns": ["name", "date", "paid_from", "accounts.account", "accounts.amount"],
   "rows": [
    ["E1", "2026-11-27", "Cash", "Rent", "1234.50"],
