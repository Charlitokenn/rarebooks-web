   ],
   "csv": [
    ["docstatus", "date", "paid_from", "accounts.account", "accounts.amount"],
    ["0", "2026-11-27", "Cash", "Rent", "1234,5"],
    ["", "", "", "Fuel", "1,5"],
    ["0", "2026-11-28", "Cash", "Rent", "100"]
   ]
  },
